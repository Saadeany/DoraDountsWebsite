# ── Felt & Form — Production Environment Template ────────────────────────
# Copy to backend/.env on the VPS, fill in real values, and NEVER commit it.
# In docker-compose this is loaded via `env_file: ./backend/.env`.

PORT=5000
NODE_ENV=production

# Must be the exact public origin the frontend is served from (https, no
# trailing slash). Wrong value here = CORS breaks or is too permissive.
CLIENT_URL=https://yourdomain.com

# ── Database — the compose file's `mysql` service, not localhost ─────────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=felt_and_form
DB_USER=felt_user
DB_PASSWORD=CHANGE_ME_use_a_long_random_password
DB_SSL=false

# ── Auth — generate with: openssl rand -hex 64 ────────────────────────────
JWT_SECRET=CHANGE_ME_64_char_random_hex_string
JWT_EXPIRES_IN=7d

# ── Uploads ────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=5

# ── Seed accounts (only used if you run `npm run seed` — see security notes
#    in SECURITY_AUDIT.md before ever running seed against production data) ──
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_unique_password

# ── SMTP ───────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=CHANGE_ME
EMAIL_FROM_NAME=Felt & Form
EMAIL_FROM_ADDRESS=hello@yourdomain.com
ADMIN_NOTIFY_EMAIL=admin@yourdomain.com

# ── Manual transfer payment methods (Vodafone Cash / InstaPay) ────────────
# Shown to the customer in the order-confirmation email and used as the
# "where do I send the money" instructions. WHATSAPP_NUMBER is where they
# send the transfer screenshot for the admin to confirm.
VODAFONE_CASH_NUMBER=+20 100 000 0000
INSTAPAY_NUMBER=+20 100 000 0000 / instapay.me/yourbrand
WHATSAPP_NUMBER=+20 100 000 0000

# ── Business logic ─────────────────────────────────────────────────────────
LOW_STOCK_THRESHOLD=5
EMAIL_VERIFY_EXPIRES_MIN=30
PASSWORD_RESET_EXPIRES_MIN=15
TAX_RATE=0.14
FREE_SHIPPING_THRESHOLD=1500

# NOTE: FLAT_SHIPPING is no longer used — shipping price is now set per
# delivery Zone from the admin panel (Admin > Zones). See MIGRATION.sql.

# ── MySQL container root password (docker-compose.yml reads this too) ─────
DB_ROOT_PASSWORD=CHANGE_ME_another_long_random_password
